diff --git a/server/paper-translation.ts b/server/paper-translation.ts
new file mode 100644
index 0000000..88018d4
--- /dev/null
+++ b/server/paper-translation.ts
@@ -0,0 +1,277 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { IncomingMessage, ServerResponse } from "node:http";
+import type { WebRuntime } from "@opendikw/web-server/runtime";
+import { translateBlocks } from "@opendikw/web-client/translate";
+import { isEnglishBody } from "@opendikw/web-client/document";
+import {
+  translationSource,
+  type SavedTranslation,
+  type TranslationJob,
+} from "../src/models/translation.js";
+import { runtimeFetch } from "./runtime-request.js";
+import { TranslationStore } from "./translation-store.js";
+
+const ROOT = "/web/papers/translation";
+interface Job {
+  id: string;
+  owner: string;
+  path: string;
+  hash: string;
+  status: TranslationJob["status"];
+  done: number;
+  total: number;
+  partial: { i: number; tr: string }[];
+  saved?: SavedTranslation;
+  error?: string;
+  controller: AbortController;
+  work?: Promise<void>;
+  finishedAt?: number;
+}
+class HttpError extends Error {
+  constructor(
+    readonly status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+function json(res: ServerResponse, status: number, body: unknown) {
+  res.statusCode = status;
+  res.setHeader("Content-Type", "application/json; charset=utf-8");
+  res.setHeader("Cache-Control", "private, no-store");
+  res.end(JSON.stringify(body));
+}
+function paperPath(value: unknown): string {
+  if (
+    typeof value !== "string" ||
+    value.length > 2048 ||
+    !value.startsWith("sources/") ||
+    !value.endsWith(".md") ||
+    value.split("/").some((part) => !part || part === "." || part === "..") ||
+    value.includes("\\") ||
+    [...value].some((char) => char.charCodeAt(0) < 32 || char.charCodeAt(0) === 127)
+  )
+    throw new HttpError(400, "论文路径无效");
+  return value;
+}
+async function bodyOf(req: IncomingMessage): Promise<Record<string, unknown>> {
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 8192) throw new HttpError(413, "请求过大");
+    chunks.push(Buffer.from(chunk));
+  }
+  try {
+    const value: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error();
+    return value as Record<string, unknown>;
+  } catch {
+    throw new HttpError(400, "请求格式无效");
+  }
+}
+
+export function createPaperTranslationService({
+  runtime,
+  store,
+  issuer,
+  coreId,
+  publicUrl,
+  translate = translateBlocks,
+  pollIntervalMs = 1200,
+}: {
+  runtime: WebRuntime;
+  store: TranslationStore;
+  issuer: string;
+  coreId: string;
+  publicUrl: string;
+  translate?: typeof translateBlocks;
+  pollIntervalMs?: number;
+}) {
+  const scope = createHash("sha256")
+    .update(JSON.stringify([issuer, coreId]))
+    .digest("hex");
+  const jobs = new Map<string, Job>();
+  let closed = false;
+  const serialize = (job: Job, sub: string): TranslationJob => ({
+    jobId: job.id,
+    status: job.status,
+    canCancel: job.owner === sub,
+    done: job.done,
+    total: job.total,
+    partial: job.partial,
+    saved: job.saved,
+    error: job.error,
+  });
+  const pageSource = async (fetcher: typeof fetch, path: string) => {
+    const encoded = path.split("/").map(encodeURIComponent).join("/");
+    const response = await fetcher(`/v1/base/pages/${encoded}`);
+    if (!response.ok)
+      throw new HttpError(
+        response.status,
+        response.status === 404 ? "论文不存在" : "无法读取论文，请检查登录状态或权限",
+      );
+    const page = (await response.json()) as { body?: unknown };
+    if (typeof page.body !== "string" || Buffer.byteLength(page.body) > 4 * 1024 * 1024)
+      throw new HttpError(413, "论文内容无效或过大");
+    const source = translationSource(page.body);
+    if (!isEnglishBody(source.body)) throw new HttpError(400, "此功能适用于英文论文");
+    return source;
+  };
+
+  async function generate(job: Job, fetcher: typeof fetch, blocks: string[]) {
+    try {
+      const result = await translate(blocks, {
+        targetLang: "zh",
+        refresh: true,
+        fetch: fetcher,
+        signal: job.controller.signal,
+        pollIntervalMs,
+        onProgress: (event) => {
+          if (job.status !== "running" || event.phase !== "partial") return;
+          job.partial = event.blocks;
+          job.done = event.blocks.length;
+        },
+      });
+      job.controller.signal.throwIfAborted();
+      if (
+        result.length !== blocks.length ||
+        result.some((text) => typeof text !== "string" || !text.trim())
+      )
+        throw new HttpError(502, "翻译结果不完整，请重新翻译");
+      const current = await pageSource(fetcher, job.path);
+      job.controller.signal.throwIfAborted();
+      if (current.hash !== job.hash) throw new HttpError(409, "原文已更新，请刷新论文后重新翻译");
+      const saved = {
+        sourceHash: job.hash,
+        translations: result,
+        savedAt: new Date().toISOString(),
+      };
+      store.put(scope, job.path, saved);
+      job.saved = saved;
+      job.status = "succeeded";
+      job.done = blocks.length;
+      job.partial = [];
+    } catch (error) {
+      job.status = job.controller.signal.aborted ? "cancelled" : "failed";
+      job.error =
+        error instanceof HttpError
+          ? error.message
+          : "翻译或保存失败，请稍后重试；已保存译文不会被覆盖";
+      job.partial = [];
+    } finally {
+      job.finishedAt = Date.now();
+    }
+  }
+
+  return {
+    matches(raw: string) {
+      return raw.split("?")[0] === ROOT || raw.split("?")[0].startsWith(ROOT + "/");
+    },
+    async handler(req: IncomingMessage, res: ServerResponse) {
+      try {
+        if (closed) throw new HttpError(503, "服务正在关闭");
+        const url = new URL(req.url ?? "/", "http://localhost");
+        const method = req.method ?? "GET";
+        if (method !== "GET" && method !== "POST") throw new HttpError(405, "不支持此操作");
+        // The extension reuses /auth/me's complete session validation/renewal,
+        // then enforces the same viewer/editor and strict write-Origin policy.
+        const fetcher = runtimeFetch(runtime, req.headers);
+        const auth = await fetcher("/web/auth/me");
+        const cookies = auth.headers.getSetCookie();
+        if (cookies.length) res.setHeader("Set-Cookie", cookies);
+        if (!auth.ok) throw new HttpError(auth.status, "请重新登录");
+        const principal = (await auth.json()) as {
+          role?: string;
+          user?: { sub?: string };
+          issuer?: string;
+          coreId?: string;
+        };
+        if (
+          !principal.user?.sub ||
+          !["viewer", "editor"].includes(principal.role ?? "") ||
+          principal.issuer !== issuer ||
+          principal.coreId !== coreId
+        )
+          throw new HttpError(403, "无知识库访问权限");
+        const sub = principal.user.sub;
+        if (method === "POST" && req.headers.origin !== publicUrl)
+          throw new HttpError(403, "请求来源无效");
+        const jobRoute = /^\/web\/papers\/translation\/jobs\/([a-f0-9-]{36})(\/cancel)?$/.exec(
+          url.pathname,
+        );
+        if (jobRoute) {
+          const job = jobs.get(jobRoute[1]);
+          if (!job) throw new HttpError(404, "翻译任务已结束，请重新打开中英对照");
+          if (jobRoute[2] && method === "POST") {
+            if (job.owner !== sub) throw new HttpError(403, "仅发起人可取消翻译");
+            if (job.status === "running") job.controller.abort();
+            await job.work;
+          } else if (jobRoute[2] || method !== "GET") throw new HttpError(405, "不支持此操作");
+          return json(res, 200, serialize(job, sub));
+        }
+        if (url.pathname !== ROOT) throw new HttpError(404, "接口不存在");
+        const input = method === "GET" ? Object.fromEntries(url.searchParams) : await bodyOf(req);
+        const path = paperPath(input.path);
+        const source = await pageSource(fetcher, path);
+        if (input.sourceHash !== source.hash)
+          throw new HttpError(409, "原文已更新，请刷新论文后重试");
+        const previous = store.get(scope, path);
+        const saved =
+          previous?.sourceHash === source.hash &&
+          previous.translations.length === source.blocks.length
+            ? previous
+            : null;
+        // Sweep bounded terminal metadata; persistent successful records do not expire.
+        for (const [id, job] of jobs)
+          if (job.finishedAt && job.finishedAt < Date.now() - 3600000) jobs.delete(id);
+        const pending = [...jobs.values()].find(
+          (job) => job.path === path && job.hash === source.hash && job.status === "running",
+        );
+        if (method === "GET" || pending || (saved && input.refresh !== true))
+          return json(res, 200, {
+            saved,
+            outdated: !!previous && !saved,
+            job: pending ? serialize(pending, sub) : null,
+          });
+        if (input.refresh != null && typeof input.refresh !== "boolean")
+          throw new HttpError(400, "刷新参数无效");
+        if (!source.blocks.length || source.blocks.length > 2000)
+          throw new HttpError(413, "论文段落数量超出翻译范围");
+        if (
+          [...jobs.values()].filter((job) => job.status === "running").length >= 8 ||
+          jobs.size >= 128
+        )
+          throw new HttpError(503, "翻译任务较多，请稍后重试");
+        const job: Job = {
+          id: randomUUID(),
+          owner: sub,
+          path,
+          hash: source.hash,
+          status: "running",
+          done: 0,
+          total: source.blocks.length,
+          partial: [],
+          controller: new AbortController(),
+        };
+        jobs.set(job.id, job);
+        // Detached from the browser: leaving the page does not discard a completed translation.
+        job.work = generate(job, fetcher, source.blocks);
+        return json(res, 202, { saved, outdated: !!previous && !saved, job: serialize(job, sub) });
+      } catch (error) {
+        json(res, error instanceof HttpError ? error.status : 500, {
+          error: {
+            message: error instanceof HttpError ? error.message : "读取或保存译文失败，请稍后重试",
+          },
+        });
+      }
+    },
+    async close() {
+      closed = true;
+      for (const job of jobs.values()) if (job.status === "running") job.controller.abort();
+      await Promise.allSettled([...jobs.values()].map((job) => job.work));
+      store.close();
+    },
+  };
+}
diff --git a/server/runtime-request.ts b/server/runtime-request.ts
new file mode 100644
index 0000000..32d8e79
--- /dev/null
+++ b/server/runtime-request.ts
@@ -0,0 +1,102 @@
+import { IncomingMessage, type ServerResponse, type OutgoingHttpHeaders } from "node:http";
+import { Socket } from "node:net";
+import { Writable } from "node:stream";
+import type { WebRuntime } from "@opendikw/web-server/runtime";
+
+/** A real Writable so Core's streaming pipeline completes, destroys and emits
+ * close normally. Only capture public ServerResponse methods the BFF uses.
+ */
+class CapturedResponse extends Writable {
+  statusCode = 200;
+  headersSent = false;
+  readonly chunks: Buffer[] = [];
+  private readonly headers: OutgoingHttpHeaders = {};
+  private size = 0;
+  setHeader(name: string, value: string | number | readonly string[]) {
+    this.headers[name.toLowerCase()] = Array.isArray(value)
+      ? [...value]
+      : (value as string | number);
+    return this;
+  }
+  getHeader(name: string) {
+    return this.headers[name.toLowerCase()];
+  }
+  getHeaders() {
+    return { ...this.headers };
+  }
+  removeHeader(name: string) {
+    delete this.headers[name.toLowerCase()];
+  }
+  hasHeader(name: string) {
+    return name.toLowerCase() in this.headers;
+  }
+  flushHeaders() {
+    this.headersSent = true;
+  }
+  writeHead(status: number, headers?: OutgoingHttpHeaders) {
+    this.statusCode = status;
+    for (const [key, value] of Object.entries(headers ?? {}))
+      if (value != null) this.setHeader(key, value);
+    this.flushHeaders();
+    return this;
+  }
+  override _write(chunk: Buffer, _encoding: BufferEncoding, done: (error?: Error | null) => void) {
+    this.size += chunk.length;
+    if (this.size > 8 * 1024 * 1024) return done(new Error("BFF response exceeds document limit"));
+    this.chunks.push(Buffer.from(chunk));
+    done();
+  }
+}
+
+/** Call public BFF routes in-process, retaining their OIDC/role/origin gates.
+ * No private package API, loopback listener, credentials or auth-table access.
+ */
+export function runtimeFetch(
+  runtime: WebRuntime,
+  headers: IncomingMessage["headers"],
+): typeof fetch {
+  return async (input, init) => {
+    const path = String(input);
+    if (!path.startsWith("/") || path.startsWith("//"))
+      throw new Error("relative BFF path required");
+    const req = new IncomingMessage(new Socket());
+    req.url = path;
+    req.method = init?.method ?? "GET";
+    req.headers = {
+      cookie: headers.cookie,
+      origin: headers.origin,
+      host: headers.host,
+      "content-type": "application/json",
+      accept: "application/json",
+    };
+    if (init?.body != null && typeof init.body !== "string") throw new Error("JSON body required");
+    req.push(init?.body ?? null);
+    if (init?.body != null) req.push(null);
+    req.complete = true;
+    const res = new CapturedResponse();
+    const signal = init?.signal;
+    signal?.throwIfAborted();
+    return new Promise<Response>((resolve, reject) => {
+      const abort = () => res.destroy(new DOMException("Aborted", "AbortError"));
+      signal?.addEventListener("abort", abort, { once: true });
+      res.once("error", reject);
+      res.once("close", () => {
+        signal?.removeEventListener("abort", abort);
+        req.destroy();
+      });
+      res.once("finish", () => {
+        const responseHeaders = new Headers();
+        for (const [key, value] of Object.entries(res.getHeaders())) {
+          if (Array.isArray(value))
+            value.forEach((item) => responseHeaders.append(key, String(item)));
+          else if (value != null) responseHeaders.set(key, String(value));
+        }
+        const body = [204, 205, 304].includes(res.statusCode) ? null : Buffer.concat(res.chunks);
+        resolve(new Response(body, { status: res.statusCode, headers: responseHeaders }));
+      });
+      void runtime
+        .handler(req, res as unknown as ServerResponse)
+        .catch((error) => res.destroy(error));
+    });
+  };
+}
