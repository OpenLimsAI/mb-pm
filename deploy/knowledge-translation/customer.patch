+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { expect, it, vi } from "vitest";
+import { AuthContext } from "@opendikw/web-ui/auth";
+import { PaperReader } from "./PaperReader";
+import { createMockClient } from "../../test/mockClient";
+import { translationSource } from "../../models/translation";
+
+const body = "# Study\n\nAn English scientific paper.";
+const saved = {
+  sourceHash: translationSource(body).hash,
+  translations: ["# 中文研究", "中文论文内容。"],
+  savedAt: "2026-10-08T00:00:00Z",
+};
+function mount() {
+  const client = createMockClient();
+  client.get.mockResolvedValue({ body, path: "sources/paper.md", assets: [], title: "Study" });
+  const view = render(
+    <AuthContext.Provider value={{ enabled: true, role: "viewer", user: { sub: "reader" } }}>
+      <PaperReader
+        theme="light"
+        paper={{ path: "sources/paper.md", title: "Study" }}
+        client={client}
+        assetBaseUrl=""
+        assetToken=""
+        translatorEnabled
+        leftCollapsed={false}
+        rightCollapsed={false}
+        onToggleLeft={() => {}}
+        onToggleRight={() => {}}
+        onUpload={() => {}}
+      />
+    </AuthContext.Provider>,
+  );
+  return view;
+}
+it("requires explicit start, then reads saved Chinese on reopening without another POST", async () => {
+  let stored: typeof saved | null = null;
+  const fetcher = vi.fn(async (_input: RequestInfo | URL, init?: RequestInit) => {
+    if (init?.method === "POST") stored = saved;
+    return new Response(JSON.stringify({ saved: stored, job: null, outdated: false }), {
+      headers: { "Content-Type": "application/json" },
+    });
+  });
+  vi.stubGlobal("fetch", fetcher);
+  let view = mount();
+  fireEvent.click(await screen.findByRole("tab", { name: "中英对照" }));
+  expect(await screen.findByRole("button", { name: "开始翻译" })).toBeEnabled();
+  expect(fetcher.mock.calls.every((call) => call[1]?.method !== "POST")).toBe(true);
+  fireEvent.click(screen.getByRole("button", { name: "开始翻译" }));
+  expect(await screen.findByText("中文论文内容。")).toBeVisible();
+  expect(screen.getByRole("button", { name: "重新翻译" })).toBeEnabled();
+  expect(fetcher.mock.calls.filter((call) => call[1]?.method === "POST")).toHaveLength(1);
+  view.unmount();
+  view = mount();
+  fireEvent.click(await screen.findByRole("tab", { name: "中英对照" }));
+  expect(await screen.findByText("中文论文内容。")).toBeVisible();
+  expect(screen.getByText("已保存")).toBeVisible();
+  expect(fetcher.mock.calls.filter((call) => call[1]?.method === "POST")).toHaveLength(1);
+  view.unmount();
+});
+
+it("keeps saved Chinese when an explicit retranslation fails", async () => {
+  const fetcher = vi.fn(
+    async (_input: RequestInfo | URL, init?: RequestInit) =>
+      new Response(
+        JSON.stringify(
+          init?.method === "POST"
+            ? { error: { message: "翻译服务暂不可用" } }
+            : { saved, job: null, outdated: false },
+        ),
+        {
+          status: init?.method === "POST" ? 503 : 200,
+          headers: { "Content-Type": "application/json" },
+        },
+      ),
+  );
+  vi.stubGlobal("fetch", fetcher);
+  mount();
+  fireEvent.click(await screen.findByRole("tab", { name: "中英对照" }));
+  expect(await screen.findByText("中文论文内容。")).toBeVisible();
+  fireEvent.click(screen.getByRole("button", { name: "重新翻译" }));
+  expect(await screen.findByText(/继续显示已保存译文/)).toBeVisible();
+  expect(screen.getByText("中文论文内容。")).toBeVisible();
+  await waitFor(() =>
+    expect(fetcher.mock.calls.filter((call) => call[1]?.method === "POST")).toHaveLength(1),
+  );
+  const post = fetcher.mock.calls.find((call) => call[1]?.method === "POST");
+  expect(JSON.parse(String(post![1]!.body))).toMatchObject({
+    path: "sources/paper.md",
+    refresh: true,
+    sourceHash: saved.sourceHash,
+  });
+});
