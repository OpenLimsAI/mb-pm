+// @vitest-environment node
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createServer } from "node:http";
+import type { WebRuntime } from "@opendikw/web-server/runtime";
+import type { TranslateOptions } from "@opendikw/web-client/translate";
+import { afterEach, expect, it, vi } from "vitest";
+import { TranslationStore } from "../../../server/translation-store";
+import { createPaperTranslationService } from "../../../server/paper-translation";
+import {
+  translationSource,
+  type TranslationLookup,
+  type TranslationJob,
+} from "../../models/translation";
+
+const original = "# Scientific Study\n\nAn English paper with consistent source material.";
+const cleanups: (() => Promise<void> | void)[] = [];
+afterEach(async () => {
+  for (const close of cleanups.splice(0).reverse()) await close();
+});
+
+async function fixture() {
+  let body = original;
+  const translate = vi.fn(async (blocks: string[], _options?: TranslateOptions) =>
+    blocks.map((_text, i) => `中文段落 ${i}`),
+  );
+  const store = new TranslationStore(":memory:");
+  const runtime: WebRuntime = {
+    async handler(req, res) {
+      res.setHeader("Content-Type", "application/json");
+      if (req.url === "/web/auth/me") {
+        const sub = req.headers.cookie;
+        res.setHeader("Set-Cookie", "renewed-session=fixture; HttpOnly");
+        if (!sub) {
+          res.statusCode = 401;
+          res.end("{}");
+          return;
+        }
+        res.end(
+          JSON.stringify({
+            user: { sub },
+            role: sub === "no-role" ? null : "viewer",
+            issuer: "https://iam.example",
+            coreId: "core",
+          }),
+        );
+      } else if (req.url === "/v1/base/pages/sources/paper.md") res.end(JSON.stringify({ body }));
+      else {
+        res.statusCode = 404;
+        res.end("{}");
+      }
+    },
+    async close() {},
+  };
+  const service = createPaperTranslationService({
+    runtime,
+    store,
+    issuer: "https://iam.example",
+    coreId: "core",
+    publicUrl: "https://kb.example",
+    translate,
+  });
+  const server = createServer((req, res) => {
+    void service.handler(req, res);
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("missing test listener");
+  const base = `http://127.0.0.1:${address.port}/web/papers/translation`;
+  cleanups.push(async () => {
+    await service.close();
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+  const request = (
+    suffix = "",
+    init: RequestInit = {},
+    sub = "viewer-a",
+    origin = "https://kb.example",
+  ) =>
+    fetch(base + suffix, {
+      ...init,
+      headers: { cookie: sub, origin, "Content-Type": "application/json", ...init.headers },
+    });
+  const query = () =>
+    "?" +
+    new URLSearchParams({ path: "sources/paper.md", sourceHash: translationSource(body).hash });
+  const start = (refresh = false, sub?: string) =>
+    request(
+      "",
+      {
+        method: "POST",
+        body: JSON.stringify({
+          path: "sources/paper.md",
+          sourceHash: translationSource(body).hash,
+          refresh,
+        }),
+      },
+      sub,
+    );
+  const terminal = async (jobId: string) => {
+    let result: TranslationJob | undefined;
+    await vi.waitFor(async () => {
+      result = (await (await request(`/jobs/${jobId}`)).json()) as TranslationJob;
+      expect(result.status).not.toBe("running");
+    });
+    return result!;
+  };
+  return {
+    store,
+    translate,
+    request,
+    query,
+    start,
+    terminal,
+    setBody: (next: string) => {
+      body = next;
+    },
+  };
+}
+
+it("reads an empty record without generating, then shares one complete saved translation", async () => {
+  const f = await fixture();
+  const lookup = await f.request(f.query());
+  expect(lookup.status).toBe(200);
+  expect(await lookup.json()).toMatchObject({ saved: null, job: null });
+  expect(f.translate).not.toHaveBeenCalled();
+  const started = await f.start();
+  expect(started.status).toBe(202);
+  const result = (await started.json()) as TranslationLookup;
+  expect((await f.terminal(result.job!.jobId)).status).toBe("succeeded");
+  const otherUser = (await (
+    await f.request(f.query(), {}, "viewer-b")
+  ).json()) as TranslationLookup;
+  expect(otherUser.saved?.translations).toEqual(["中文段落 0", "中文段落 1"]);
+  expect(otherUser.saved?.sourceHash).toBe(translationSource(original).hash);
+  expect((await f.start()).status).toBe(200);
+  expect(f.translate).toHaveBeenCalledTimes(1);
+});
+
+it("persists complete records across closing and reopening the SQLite database", () => {
+  const directory = mkdtempSync(join(tmpdir(), "mb-translation-"));
+  cleanups.push(() => rmSync(directory, { recursive: true, force: true }));
+  const path = join(directory, "translations.sqlite");
+  const value = { sourceHash: "hash", savedAt: "2026-10-08T00:00:00Z", translations: ["中文译文"] };
+  const first = new TranslationStore(path);
+  first.put("scope", "sources/paper.md", value);
+  first.close();
+  const reopened = new TranslationStore(path);
+  try {
+    expect(reopened.get("scope", "sources/paper.md")).toEqual(value);
+    expect(reopened.get("another-core", "sources/paper.md")).toBeNull();
+  } finally {
+    reopened.close();
+  }
+});
+
+it("retranslates only on explicit refresh and preserves the old result on failure", async () => {
+  const f = await fixture();
+  const first = (await (await f.start()).json()) as TranslationLookup;
+  await f.terminal(first.job!.jobId);
+  const saved = ((await (await f.request(f.query())).json()) as TranslationLookup).saved;
+  f.translate.mockRejectedValueOnce(new Error("provider failure with private diagnostic"));
+  const second = (await (await f.start(true)).json()) as TranslationLookup;
+  expect(second.saved).toEqual(saved);
+  const failed = await f.terminal(second.job!.jobId);
+  expect(failed.status).toBe("failed");
+  expect(failed.error).not.toContain("private diagnostic");
+  expect(((await (await f.request(f.query())).json()) as TranslationLookup).saved).toEqual(saved);
+  f.translate.mockResolvedValueOnce(["新版中文 1", "新版中文 2"]);
+  const third = (await (await f.start(true)).json()) as TranslationLookup;
+  expect((await f.terminal(third.job!.jobId)).saved?.translations).toEqual([
+    "新版中文 1",
+    "新版中文 2",
+  ]);
+});
+
+it("detects updated source without automatically starting translation or serving stale Chinese", async () => {
+  const f = await fixture();
+  const first = (await (await f.start()).json()) as TranslationLookup;
+  await f.terminal(first.job!.jobId);
+  f.setBody(original + "\n\nNew conclusions.");
+  expect(await (await f.request(f.query())).json()).toMatchObject({
+    saved: null,
+    outdated: true,
+    job: null,
+  });
+  expect(f.translate).toHaveBeenCalledTimes(1);
+  const stale =
+    "?" +
+    new URLSearchParams({ path: "sources/paper.md", sourceHash: translationSource(original).hash });
+  expect((await f.request(stale)).status).toBe(409);
+});
+
+it("rejects incomplete translations and source changes during generation without saving", async () => {
+  const f = await fixture();
+  f.translate.mockResolvedValueOnce([""]);
+  let result = (await (await f.start()).json()) as TranslationLookup;
+  expect((await f.terminal(result.job!.jobId)).status).toBe("failed");
+  expect(((await (await f.request(f.query())).json()) as TranslationLookup).saved).toBeNull();
+  f.translate.mockImplementationOnce(async (blocks) => {
+    f.setBody(original + "\n\nChanged during generation.");
+    return blocks.map(() => "中文");
+  });
+  result = (await (await f.start()).json()) as TranslationLookup;
+  expect((await f.terminal(result.job!.jobId)).error).toMatch(/原文已更新/);
+  expect(((await (await f.request(f.query())).json()) as TranslationLookup).saved).toBeNull();
+});
+
+it("coalesces concurrent readers and restricts cancellation to the initiating user", async () => {
+  const f = await fixture();
+  f.translate.mockImplementationOnce(
+    (_blocks, options) =>
+      new Promise<string[]>((_resolve, reject) => {
+        options!.signal!.addEventListener(
+          "abort",
+          () => reject(new DOMException("Aborted", "AbortError")),
+          { once: true },
+        );
+      }),
+  );
+  const a = (await (await f.start()).json()) as TranslationLookup;
+  const b = (await (await f.start(false, "viewer-b")).json()) as TranslationLookup;
+  expect(b.job?.jobId).toBe(a.job?.jobId);
+  expect(b.job?.canCancel).toBe(false);
+  expect(f.translate).toHaveBeenCalledTimes(1);
+  expect(
+    (await f.request(`/jobs/${a.job!.jobId}/cancel`, { method: "POST" }, "viewer-b")).status,
+  ).toBe(403);
+  expect(
+    (
+      (await (
+        await f.request(`/jobs/${a.job!.jobId}/cancel`, { method: "POST" })
+      ).json()) as TranslationJob
+    ).status,
+  ).toBe("cancelled");
+  expect(((await (await f.request(f.query())).json()) as TranslationLookup).saved).toBeNull();
+});
+
+it("keeps new endpoints authenticated, role checked and protected from cross-origin writes", async () => {
+  const f = await fixture();
+  expect((await f.request(f.query(), {}, "")).status).toBe(401);
+  expect((await f.request(f.query(), {}, "no-role")).status).toBe(403);
+  expect(
+    (await f.request("", { method: "POST", body: "{}" }, "viewer-a", "https://evil.example"))
+      .status,
+  ).toBe(403);
+  expect(
+    (await f.request("?" + new URLSearchParams({ path: "sources/../private.md", sourceHash: "x" })))
+      .status,
+  ).toBe(400);
+  const response = await f.request(f.query());
+  expect(response.headers.get("Cache-Control")).toBe("private, no-store");
+  expect(response.headers.getSetCookie()).toEqual(["renewed-session=fixture; HttpOnly"]);
+  expect(f.translate).not.toHaveBeenCalled();
+});
