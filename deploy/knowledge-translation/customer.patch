@@ -0,0 +1,49 @@
+// @vitest-environment node
+import { Readable } from "node:stream";
+import { pipeline } from "node:stream/promises";
+import { expect, it, vi } from "vitest";
+import type { WebRuntime } from "@opendikw/web-server/runtime";
+import { runtimeFetch } from "../../../server/runtime-request";
+
+it("captures BFF streamed pages and completes/cleans the pipeline with the original auth headers", async () => {
+  const close = vi.fn();
+  const handler = vi.fn<WebRuntime["handler"]>(async (req, res) => {
+    expect(req.headers.cookie).toBe("opaque-test-session");
+    expect(req.headers.origin).toBe("https://kb.example");
+    res.setHeader("Content-Type", "application/json");
+    res.setHeader("Set-Cookie", ["renewed=fixture; HttpOnly", "second=fixture; HttpOnly"]);
+    res.on("close", close);
+    res.flushHeaders();
+    await pipeline(Readable.from([Buffer.from('{"body":"'), Buffer.from('English page"}')]), res);
+  });
+  const response = await runtimeFetch(
+    { handler, async close() {} },
+    { cookie: "opaque-test-session", origin: "https://kb.example" },
+  )("/v1/base/pages/sources/paper.md");
+  expect(await response.json()).toEqual({ body: "English page" });
+  await vi.waitFor(() => expect(close).toHaveBeenCalledOnce());
+  expect(response.headers.getSetCookie()).toHaveLength(2);
+});
+
+it("feeds translation JSON to the shared submit route without losing or ending its body", async () => {
+  const handler = vi.fn<WebRuntime["handler"]>(async (req, res) => {
+    const chunks: Buffer[] = [];
+    for await (const chunk of req) chunks.push(chunk);
+    expect(req.method).toBe("POST");
+    expect(JSON.parse(Buffer.concat(chunks).toString())).toEqual({
+      blocks: ["English"],
+      targetLang: "zh",
+    });
+    res.statusCode = 202;
+    res.end('{"jobId":"fixture"}');
+  });
+  const response = await runtimeFetch(
+    { handler, async close() {} },
+    { origin: "https://kb.example" },
+  )("/web/translate/submit", {
+    method: "POST",
+    body: JSON.stringify({ blocks: ["English"], targetLang: "zh" }),
+  });
+  expect(response.status).toBe(202);
+  expect(await response.json()).toEqual({ jobId: "fixture" });
+});
