+++ b/src/features/research/useStoredTranslation.ts
@@ -0,0 +1,194 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { splitMarkdownBlocks } from "@opendikw/web-client/document";
+import type { BilingualBlock } from "@opendikw/web-ui/reader";
+import {
+  translationSource,
+  type SavedTranslation,
+  type TranslationJob,
+  type TranslationLookup,
+} from "../../models/translation";
+
+const ROOT = "/web/papers/translation";
+interface State {
+  saved: SavedTranslation | null;
+  job: TranslationJob | null;
+  checking: boolean;
+  error: string | null;
+  outdated: boolean;
+}
+const empty = (): State => ({
+  saved: null,
+  job: null,
+  checking: false,
+  error: null,
+  outdated: false,
+});
+
+async function jsonRequest<T>(path: string, init: RequestInit): Promise<T> {
+  const response = await fetch(path, { ...init, credentials: "same-origin" });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data?.error?.message || "无法读取译文，请稍后重试");
+  return data as T;
+}
+function delay(signal: AbortSignal) {
+  return new Promise<void>((resolve, reject) => {
+    const abort = () => {
+      clearTimeout(timer);
+      reject(new DOMException("Aborted", "AbortError"));
+    };
+    const timer = setTimeout(() => {
+      signal.removeEventListener("abort", abort);
+      resolve();
+    }, 1200);
+    signal.addEventListener("abort", abort, { once: true });
+  });
+}
+
+export function useStoredTranslation({
+  body,
+  path,
+  enabled,
+}: {
+  body: string;
+  path: string | null;
+  enabled: boolean;
+}) {
+  const [active, setActive] = useState(false);
+  const [state, setState] = useState<State>(empty);
+  const source = useMemo(() => translationSource(body), [body]);
+  const parts = useMemo(() => splitMarkdownBlocks(source.body), [source.body]);
+  const requestRef = useRef<AbortController | null>(null);
+  const busyRef = useRef(false);
+  const identity = path + ":" + source.hash;
+  const identityRef = useRef(identity);
+  identityRef.current = identity;
+
+  useEffect(() => {
+    setActive(false);
+    setState(empty());
+    busyRef.current = false;
+    requestRef.current?.abort();
+    return () => requestRef.current?.abort();
+  }, [identity]);
+
+  const applyJob = useCallback((job: TranslationJob) => {
+    setState((previous) => ({
+      ...previous,
+      job,
+      checking: false,
+      saved: job.saved ?? previous.saved,
+      error: job.status === "failed" ? job.error || "翻译失败，请重试" : null,
+    }));
+  }, []);
+  const poll = useCallback(
+    async (job: TranslationJob, signal: AbortSignal) => {
+      let current = job;
+      while (current.status === "running") {
+        await delay(signal);
+        current = await jsonRequest<TranslationJob>(
+          `${ROOT}/jobs/${encodeURIComponent(current.jobId)}`,
+          { signal },
+        );
+        signal.throwIfAborted();
+        applyJob(current);
+      }
+    },
+    [applyJob],
+  );
+
+  const run = useCallback(
+    async (generate = false, refresh = false) => {
+      if (!path || busyRef.current || (generate && !enabled)) return;
+      busyRef.current = true;
+      requestRef.current?.abort();
+      const controller = new AbortController();
+      requestRef.current = controller;
+      const requestIdentity = identity;
+      setState((previous) => ({ ...previous, checking: true, error: null }));
+      try {
+        const query = new URLSearchParams({ path, sourceHash: source.hash });
+        const result = await jsonRequest<TranslationLookup>(generate ? ROOT : `${ROOT}?${query}`, {
+          signal: controller.signal,
+          ...(generate
+            ? {
+                method: "POST",
+                headers: { "Content-Type": "application/json" },
+                body: JSON.stringify({ path, sourceHash: source.hash, refresh }),
+              }
+            : {}),
+        });
+        controller.signal.throwIfAborted();
+        if (identityRef.current !== requestIdentity) return;
+        setState({ ...result, checking: false, error: null });
+        if (result.job) await poll(result.job, controller.signal);
+      } catch (error) {
+        if (!controller.signal.aborted && identityRef.current === requestIdentity)
+          setState((previous) => ({
+            ...previous,
+            checking: false,
+            error: error instanceof Error ? error.message : "翻译服务不可用",
+          }));
+      } finally {
+        if (requestRef.current === controller) busyRef.current = false;
+      }
+    },
+    [path, identity, source.hash, enabled, poll],
+  );
+
+  const cancel = useCallback(async () => {
+    const job = state.job;
+    if (!job?.canCancel || job.status !== "running") return;
+    requestRef.current?.abort();
+    busyRef.current = false;
+    const requestIdentity = identity;
+    try {
+      const next = await jsonRequest<TranslationJob>(`${ROOT}/jobs/${job.jobId}/cancel`, {
+        method: "POST",
+      });
+      if (identityRef.current === requestIdentity) applyJob(next);
+    } catch (error) {
+      if (identityRef.current === requestIdentity)
+        setState((previous) => ({
+          ...previous,
+          checking: false,
+          error: error instanceof Error ? error.message : "取消失败",
+        }));
+    }
+  }, [state.job, identity, applyJob]);
+
+  const toggle = useCallback(() => {
+    if (active) {
+      setActive(false);
+      return;
+    }
+    setActive(true);
+    // Opening the mode only reads persisted state, never starts an LLM job.
+    if (!state.saved && !state.job && !state.checking) void run();
+  }, [active, state.saved, state.job, state.checking, run]);
+
+  const blocks = useMemo<BilingualBlock[]>(() => {
+    const partial = new Map(state.job?.partial?.map((block) => [block.i, block.tr]));
+    let index = 0;
+    return parts.map((block) => {
+      if (block.kind === "special") return { kind: "special", source: block.md };
+      const i = index++;
+      return {
+        kind: "text",
+        source: block.md,
+        translation: state.saved?.translations[i] ?? partial.get(i),
+      };
+    });
+  }, [parts, state.saved, state.job]);
+
+  return {
+    active,
+    ...state,
+    blocks,
+    translating: state.job?.status === "running" && !state.error,
+    toggle,
+    start: () => void run(true, false),
+    forceRetranslate: () => void run(true, true),
+    cancel: () => void cancel(),
+    retryLookup: () => void run(),
+  };
+}
diff --git a/src/models/translation.ts b/src/models/translation.ts
new file mode 100644
index 0000000..4a27e8d
--- /dev/null
+++ b/src/models/translation.ts
@@ -0,0 +1,37 @@
+import { sha256 } from "@noble/hashes/sha2.js";
+import { bytesToHex } from "@noble/hashes/utils.js";
+import { parseMarkdownDocument, splitMarkdownBlocks } from "@opendikw/web-client/document";
+
+export function translationSource(body: string) {
+  const readerBody = parseMarkdownDocument(body, { stripDuplicateTitle: false }).body;
+  return {
+    body: readerBody,
+    hash: bytesToHex(sha256(new TextEncoder().encode(readerBody))),
+    blocks: splitMarkdownBlocks(readerBody)
+      .filter((block) => block.kind === "text")
+      .map((block) => block.md),
+  };
+}
+
+export interface SavedTranslation {
+  sourceHash: string;
+  translations: string[];
+  savedAt: string;
+}
+
+export interface TranslationJob {
+  jobId: string;
+  status: "running" | "succeeded" | "failed" | "cancelled";
+  canCancel: boolean;
+  done: number;
+  total: number;
+  partial?: { i: number; tr: string }[];
+  saved?: SavedTranslation;
+  error?: string;
+}
+
+export interface TranslationLookup {
+  saved: SavedTranslation | null;
+  job: TranslationJob | null;
+  outdated: boolean;
+}
