new file mode 100644
index 0000000..888dc7d
--- /dev/null
+++ b/server/translation-store.ts
@@ -0,0 +1,52 @@
+import { chmodSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import type { SavedTranslation } from "../src/models/translation.js";
+
+export class TranslationStore {
+  private readonly db: DatabaseSync;
+  constructor(path: string) {
+    if (path !== ":memory:") mkdirSync(dirname(path), { recursive: true });
+    this.db = new DatabaseSync(path);
+    if (path !== ":memory:") chmodSync(path, 0o600);
+    this.db.exec(`
+      PRAGMA journal_mode = WAL;
+      PRAGMA busy_timeout = 5000;
+      CREATE TABLE IF NOT EXISTS paper_translations (
+        scope TEXT NOT NULL, paper_path TEXT NOT NULL, source_hash TEXT NOT NULL,
+        language TEXT NOT NULL, version INTEGER NOT NULL, translations TEXT NOT NULL,
+        saved_at TEXT NOT NULL, PRIMARY KEY(scope, paper_path, language, version)
+      );
+    `);
+  }
+
+  get(scope: string, path: string): SavedTranslation | null {
+    const row = this.db
+      .prepare(
+        "SELECT source_hash, translations, saved_at FROM paper_translations WHERE scope=? AND paper_path=? AND language='zh' AND version=1",
+      )
+      .get(scope, path);
+    if (!row) return null;
+    return {
+      sourceHash: String(row.source_hash),
+      translations: JSON.parse(String(row.translations)) as string[],
+      savedAt: String(row.saved_at),
+    };
+  }
+
+  put(scope: string, path: string, value: SavedTranslation): void {
+    this.db
+      .prepare(
+        `
+      INSERT INTO paper_translations VALUES (?, ?, ?, 'zh', 1, ?, ?)
+      ON CONFLICT(scope, paper_path, language, version) DO UPDATE SET
+        source_hash=excluded.source_hash, translations=excluded.translations, saved_at=excluded.saved_at
+    `,
+      )
+      .run(scope, path, value.sourceHash, JSON.stringify(value.translations), value.savedAt);
+  }
+
+  close(): void {
+    this.db.close();
+  }
+}
