# 数据库（不设则默认 SQLite 单文件；部署用 PostgreSQL）
DATABASE_URL=postgresql+psycopg://cmc:cmc@localhost:5432/cmc_pms

# 应用
APP_ENV=development
# 兼作 IAM 会话令牌的加密密钥：必须换成 ≥32 字符的随机值（如 openssl rand -hex 32），否则登录返回 503
APP_SECRET=change-me-in-production-use-openssl-rand-hex-32
# 知识报告的个人模型配置也由此密钥加密保存到数据库；需稳定保留并随备份妥善管理。
# 个人模型地址允许明确的局域网/本机自托管服务，禁止云元数据、链路本地及特殊地址；不使用代理或跟随重定向。
APP_CORS_ORIGINS=http://localhost:5175

# 日志
LOG_LEVEL=INFO

# AI 设置文件（服务商地址 / 模型 / API Key，权限 0600，不回传浏览器）；部署时指向持久化、受保护的目录
AI_SETTINGS_PATH=.local/ai-settings.json

# —— mb-casd / Casdoor IAM（授权码 + PKCE 由后端完成，密钥只保存在后端）——
# 浏览器访问的 IAM 地址，同时是 token 的 iss
CASDOOR_ENDPOINT=http://localhost:8000
# 后端访问 IAM 的地址（换 token / 拉 JWKS）；容器内如 http://host.docker.internal:8000，留空同上
CASDOOR_INTERNAL_URL=
CASDOOR_CLIENT_ID=mppm-client-id-0001
# 必填：Casdoor 应用 mp-pm 的 client secret
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG=mabpharm
# 用户访问本系统的 origin；需在 Casdoor 应用中登记回调 {PMS_PUBLIC_URL}/api/v1/auth/callback
# 与登出回跳 {PMS_PUBLIC_URL}/login（localhost / 127.0.0.1 由 Casdoor 免登记放行）
PMS_PUBLIC_URL=http://localhost:5175
# 可续期会话的空闲上限；旧会话仍沿用原截止时间。
IAM_SESSION_SECONDS=3600
# 从完整登录开始最多八小时，活跃使用和刷新均不会延长。
IAM_SESSION_ABSOLUTE_SECONDS=28800
# 提前两分钟由服务端刷新短令牌；不向浏览器提供 OAuth 令牌。
IAM_REFRESH_LEEWAY_SECONDS=120
# HTTPS 部署设为 true
IAM_COOKIE_SECURE=false
# 本系统不提供自助注册；账号由管理员在 IAM 平台开通。

# —— 员工门户（正式入口 www.openlims.ai）——
# 本地同域调试可留空；正式部署须使用独立 Casdoor 应用，不复用 PM client ID。
PORTAL_PUBLIC_URL=
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
# 可覆盖新门户应用的 JWKS 地址；留空使用 CASDOOR_JWKS_URL / 默认 IAM 公钥端点。
# 必须核对该端点包含门户应用所用签名证书，否则配置门户应用自身的 JWKS URL。
PORTAL_JWKS_URL=

# —— 知识方案只读连接企业 DIKW（可选；不配置时仅使用个人录入资料）——
# 仅服务端进程使用，不能添加 VITE_ 前缀。固定Core地址，令牌由运维注入。
SOLUTION_KB_CORE_URL=
SOLUTION_KB_TOKEN=
SOLUTION_KB_PUBLIC_URL=https://kb.openlims.ai
# 正式环境回调 https://www.openlims.ai/api/v1/portal/callback；登出回跳 https://www.openlims.ai/login。
# MDM 页面根地址（包括部署前缀 /mdm/）；空值关闭入口，仍由 MDM 独立认证授权。
MDM_PUBLIC_URL=

# 信息获取：默认不启动，启用前持久化原文目录。
INFORMATION_APP_ENABLED=false
INFORMATION_WORKER_ENABLED=false
INFORMATION_DATA_DIR=.local/information
INFORMATION_MAX_ARCHIVE_MB=5120
# 可选知识库内部 BFF；密钥新生成并与 KB INFORMATION_BRIDGE_SECRET 配对。
INFORMATION_KB_URL=
INFORMATION_KB_SECRET=


# MDM phase 2: blank/false keeps delegated creation and provider logout disabled.
# A distinct client audience is accepted only on integration APIs; never the MDM login audience.
MDM_DELEGATION_CLIENT_ID=
MDM_SOURCE_NAMESPACE=mdm
# Requires the provider applications' backchannelLogoutUri pointing to /api/v1/auth/backchannel-logout.
# Signed sub notifications deliberately revoke all existing sessions of that app/user even with sid.
# true also requires each request to pass RFC7662 active introspection (no cache).
# PM/portal use their own client Basic auth; delegation uses PM client, same Casdoor cert.
# A distinct delegation certificate fails closed; never share the MDM client secret.
OIDC_GLOBAL_LOGOUT_ENABLED=false
# Required for global logout/status checking. Explicit deployment confirmation only:
# this org must expose isForbidden/isDeleted to Self/Public without GetFilteredUser masking.
# Verify a disabled ordinary user's self-read returns true before setting true. No role sync.
CASDOOR_ACCOUNT_STATUS_VISIBLE=false

# Unified notes: exact browser origin + optional opt-in Wisdom projection
KNOWLEDGE_NOTES_ORIGIN=http://localhost:4322
NOTES_WISDOM_CORE_URL=
NOTES_WISDOM_TOKEN=
NOTES_WISDOM_WORKER_ENABLED=false
