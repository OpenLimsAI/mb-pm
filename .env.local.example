# 复制为 .env.local 即可生效
# 本地工作台固定使用 http://localhost:1234，配套后端登录与 CORS 使用相同来源。
#
# 数据源开关：
#   未设置 / false → 使用前端 mock 数据（离线演示，无需登录）
#   true            → 调用后端 API（需 mb-casd IAM 登录，见 docs/configuration.md）
VITE_USE_API=false

# 后端 API 路径：保持同源相对路径（IAM 会话 cookie 与登录回调依赖同源）
VITE_API_URL=/api/v1

# 开发代理目标：npm run dev 时 /api 转发到的 FastAPI 地址（默认 http://127.0.0.1:8000）
# API_PROXY_TARGET=http://127.0.0.1:8000

# 界面模式，通常留空：www.openlims.ai 自动为门户，pm.openlims.ai 自动为项目管理，
# 本地开发自动 combined。独立本地联调可指定 portal / pm；生产同一镜像请不要固定模式。
# VITE_APP_MODE=portal

# 本地知识库独立启动端口（默认 4322），只在 localhost / 127.0.0.1 / [::1] 开发时使用。
# 线上域名始终进入 https://kb.openlims.ai/；本机开发或 combined 构建进入 localhost 上此端口。
# VITE_KNOWLEDGE_PORT=4322
