# 复制为 .env.local 即可生效
#
# 数据源开关：
#   未设置 / false → 使用前端 mock 数据（离线演示，无需登录）
#   true            → 调用后端 API（需 mb-casd IAM 登录，见 README「IAM 登录」）
VITE_USE_API=false

# 后端 API 路径：保持同源相对路径（IAM 会话 cookie 与登录回调依赖同源）
VITE_API_URL=/api/v1

# 开发代理目标：npm run dev 时 /api 转发到的 FastAPI 地址（默认 http://127.0.0.1:8000）
# API_PROXY_TARGET=http://127.0.0.1:8000
