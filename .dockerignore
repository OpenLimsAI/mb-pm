# —— 依赖 / 构建产物（镜像内重新安装与构建）——
node_modules
dist
dist-ssr
backend/.venv
backend/.venv-*
backend/.venv.*
backend/.local
.venv
**/__pycache__/
*.py[cod]
.pytest_cache
.coverage
.ruff_cache

# —— 数据库 / 环境密钥（绝不进镜像）——
*.db
*.sqlite
.env
.env.*
!.env.example
!.env.local.example
backend/.env
*.local

# —— VCS / 编辑器 / 系统 —— #
.git
.gitignore
.github
.claude
.vscode
.idea
.DS_Store
*.log

# —— 文档 / 非运行资产（不影响构建）——
*.md
docs
!docs/releases/
!docs/releases/notes.json
!docs/releases/style.css
docx
**/*.docx
**/*.xlsx

# AI 设置（含 API Key）不进镜像构建上下文
**/.local

# SSH 私钥等凭据不进构建上下文
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem

# 部署目录包含运行配置和凭据，不属于镜像源码。
deploy
